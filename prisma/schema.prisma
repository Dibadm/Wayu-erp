// WAYU Pharmaceutical Inventory System
// Prisma Schema — PostgreSQL (v2.1 — Supplier & Purchasing Module)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(STAFF)
  isSalesperson Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements           Movement[]
  auditLogs           AuditLog[]
  purchaseOrders      PurchaseOrder[]
  sales               Sale[]          @relation("cashier")
  salesAsSalesperson  Sale[]          @relation("salesperson")
  commissionRates     CommissionRate[] @relation("commissionRates")
  importBatches       ImportBatch[]
  expenses            Expense[]
  bankRecs            BankReconciliation[]
  bankAccounts        BankAccount[]
  cashInflows         CashInflow[]
  cashOutflows        CashOutflow[]
  transfers           BankTransfer[]   @relation("transferCreatedBy")
  loansCreated        Loan[]
  loanRepayments      LoanRepayment[]
  investments         Investment[]
  creditProfiles      CreditProfile[] @relation("creditApprover")
  creditTransactions  CreditTransaction[]
  collectionCases     CollectionCase[]

  @@map("users")
}

// ─── Suppliers ────────────────────────────────────────────────────────────────

model Supplier {
  id            String   @id @default(cuid())
  name          String                      // Company name
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  taxNumber     String?
  notes         String?
  status        SupplierStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

// ─── Purchase Orders ──────────────────────────────────────────────────────────

model PurchaseOrder {
  id               String          @id @default(cuid())
  poNumber         String          @unique  // e.g. PO-2024-0001
  status           POStatus        @default(DRAFT)
  orderDate        DateTime        @default(now())
  expectedDelivery DateTime?
  notes            String?
  totalCost        Decimal         @default(0) @db.Decimal(12, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  supplierId       String
  supplier         Supplier        @relation(fields: [supplierId], references: [id])

  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id])

  items            PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  quantityOrdered Int
  quantityReceived Int     @default(0)
  unitCost        Decimal  @db.Decimal(10, 2)
  totalCost       Decimal  @db.Decimal(12, 2)
  batchNumber     String?
  expiryDate      DateTime?
  notes           String?

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId       String
  product         Product  @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

// ─── Locations / Warehouses ───────────────────────────────────────────────────

model Location {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  address   String?
  type      LocationType @default(WAREHOUSE)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  inventory LocationInventory[]
  movements Movement[]
  batches   Batch[]

  @@map("locations")
}

model LocationInventory {
  id        String   @id @default(cuid())
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@map("location_inventory")
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  description   String?
  category      String   @default("General")
  quantity      Int      @default(0)
  minStockLevel Int      @default(10)
  maxStockLevel Int?                         // Phase 1 — "Overstock" threshold (CF19/ERP SC18)
  unit          String   @default("units")
  costPrice     Decimal? @db.Decimal(10, 2)   // v2.1 — cost per unit
  sellingPrice  Decimal? @db.Decimal(10, 2)   // v2.1 — retail price per unit
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements         Movement[]
  batches           Batch[]
  locationInventory  LocationInventory[]
  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]
  commissionRates   CommissionRate[]
  salesPlans        SalesPlan[]

  @@map("products")
}

// ─── Batches (Expiry Tracking) ────────────────────────────────────────────────

model Batch {
  id           String      @id @default(cuid())
  batchNumber  String
  quantity     Int
  expiryDate   DateTime
  receivedDate DateTime    @default(now())
  status       BatchStatus @default(ACTIVE)
  notes        String?

  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  locationId   String
  location     Location @relation(fields: [locationId], references: [id])

  movements    Movement[]

  @@map("batches")
}

// ─── Movements ────────────────────────────────────────────────────────────────

model Movement {
  id         String       @id @default(cuid())
  type       MovementType
  quantity   Int
  notes      String?
  timestamp  DateTime     @default(now())
  reference  String?

  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId     String
  user       User      @relation(fields: [userId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  batchId    String?
  batch      Batch?    @relation(fields: [batchId], references: [id])

  @@map("movements")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entity     String
  entityId   String
  entityName String?
  changes    Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime    @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ─── Backup Records ───────────────────────────────────────────────────────────

model BackupRecord {
  id          String       @id @default(cuid())
  filename    String
  sizeBytes   BigInt?
  status      BackupStatus @default(PENDING)
  triggeredBy String
  storagePath String?
  errorMsg    String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?

  @@map("backup_records")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  VIEWER
  FINANCE
  INVENTORY
  SALES
  CREDIT_OFFICER
}

enum SaleSource {
  MANUAL
  EXCEL_IMPORT
}

enum CostMethod {
  FIFO
  FEFO
}

enum CommissionScope {
  GLOBAL
  SALESPERSON
  PRODUCT
  COMBO
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

enum LocationType {
  WAREHOUSE
  BRANCH
  CLINIC
  PHARMACY
}

enum BatchStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  QUARANTINE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  BACKUP
  IMPORT
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum POStatus {
  DRAFT
  PENDING
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

// ─── POS v2.2 ─────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?  @unique
  tinNo     String?                          // Phase 1 — client's Tin No (ERP Sells19)
  taxable   Boolean  @default(false)         // Phase 1 — WHT only for customers who ask (decision #6)
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales                Sale[]
  arStatements         ARStatement[]
  creditProfile        CreditProfile?
  creditApplications   CreditApplication[]
  creditAging          CreditAging[]
  collectionCases      CollectionCase[]
  overdueNotifications OverdueNotification[]

  @@map("customers")
}

model Sale {
  id             String      @id @default(cuid())
  receiptNumber  String      @unique
  status         SaleStatus  @default(COMPLETED)
  subtotal       Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  totalCost      Decimal     @default(0) @db.Decimal(12, 2)  // COGS
  profit         Decimal     @default(0) @db.Decimal(12, 2)
  taxable        Boolean     @default(false)                 // Phase 1 — WHT applied? (decision #6)
  ethiopianMonth String?                                 // Phase 1 — precomputed Ethiopian month label for reporting
  source         SaleSource  @default(MANUAL)              // Phase 1 — MANUAL | EXCEL_IMPORT (decision #3)
  notes          String?
  createdAt      DateTime    @default(now())

  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])

  cashierId      String
  cashier        User        @relation("cashier", fields: [cashierId], references: [id])

  salespersonId  String
  salesperson    User        @relation("salesperson", fields: [salespersonId], references: [id])

  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])

  items          SaleItem[]
  payments       SalePayment[]
  arStatements   ARStatement[]

  @@index([createdAt])
  @@index([cashierId])
  @@index([salespersonId])
  @@index([importBatchId])
  @@map("sales")
}

model SaleItem {
  id           String   @id @default(cuid())
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  unitCost     Decimal  @default(0) @db.Decimal(10, 2)
  discount     Decimal  @default(0) @db.Decimal(10, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
  profit       Decimal  @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)  // Phase 1 — pre-tax commission (decision #1/#6)
  batchesUsed  Json?    // [{batchId, qty}] — FEFO audit trail

  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId    String
  product      Product  @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model SalePayment {
  id        String        @id @default(cuid())
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?       // Card last4, mobile money ref, etc.

  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  PARTIAL_REFUND
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
}

// ─── Phase 1: Commission, Import/Sync, Settings ──────────────────────────────

// Commission rates — admin-configured, nothing hardcoded (decision #1).
// Resolution order at sale time (most specific wins):
//   salesperson+product+tier → product+tier → salesperson+tier → global+tier
model CommissionRate {
  id            String          @id @default(cuid())
  scope         CommissionScope @default(GLOBAL)
  salespersonId String?
  salesperson   User?           @relation("commissionRates", fields: [salespersonId], references: [id])
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id])
  tierFromQty   Int             @default(0)   // inclusive lower bound of sold-qty tier
  tierToQty     Int?                          // inclusive upper bound; null = infinity
  rate          Decimal         @db.Decimal(5, 2)  // % of pre-tax line total
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([scope])
  @@index([salespersonId])
  @@index([productId])
  @@map("commission_rates")
}

// Every Excel import is recorded for auditability + two-way sync (decision #3)
model ImportBatch {
  id         String   @id @default(cuid())
  fileName   String
  importedById String
  importedBy User     @relation(fields: [importedById], references: [id])
  importedAt DateTime @default(now())
  rowCount   Int      @default(0)
  newRows    Int      @default(0)
  status     String   @default("COMPLETED") // COMPLETED | PARTIAL | FAILED
  mismatches Json?    // [{entity, entityId, excelValue, appValue}] — surfaced to admin

  sales      Sale[]
  conflicts  SyncConflict[]

  @@index([importedById])
  @@map("import_batches")
}

// Records a conflict between an Excel row and existing app data on re-import
model SyncConflict {
  id            String   @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  entity        String   // e.g. "Sale", "PurchaseOrder"
  entityId      String
  entityName    String?
  field         String?
  excelValue    String?
  appValue      String?
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([importBatchId])
  @@index([resolved])
  @@map("sync_conflicts")
}

// App-level settings (single-row style key/value store)
model Setting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String?
  updatedAt  DateTime @updatedAt

  @@map("settings")
}

// ─── Phase 5: CF19 credit/AR, expenses, bank rec, sales plan ──────────────────

// Accounts-receivable ledger (CF19 Cr sells18 / CreditS): outstanding balances
// per customer. A sale is "credit" when its payments sum to less than its total.
model ARStatement {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId     String?  // linked sale if any
  sale       Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  invoiceNo  String
  issuedAt   DateTime @default(now())
  dueDate    DateTime?
  amount     Decimal  @db.Decimal(12, 2)         // original receivable
  paid       Decimal  @default(0) @db.Decimal(12, 2)
  status     ARStatus @default(OPEN)            // OPEN | PARTIAL | PAID | OVERDUE
  notes      String?

  collectionCases      CollectionCase[]
  overdueNotifications OverdueNotification[]

  @@index([customerId])
  @@index([status])
  @@map("ar_statements")
}

enum ARStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
}

// General-ledger expenses (CF19 Trans → All Exp). SUMIFS by category.
model Expense {
  id          String        @id @default(cuid())
  category    String                                   // e.g. Rent, Salary, Utilities
  description String?
  amount      Decimal        @db.Decimal(12, 2)
  type        ExpenseType    @default(DEBIT)           // DEBIT (cost) | CREDIT (refund/income)
  incurredAt  DateTime       @default(now())
  reference   String?
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
  @@index([incurredAt])
  @@map("expenses")
}

enum ExpenseType {
  DEBIT
  CREDIT
}

// Sales plan / budget (CF19 19 Sells plan): planned qty & value per product per month.
model SalesPlan {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  periodLabel   String                              // Gregorian month label, e.g. "Jan 2026"
  periodStart   DateTime
  plannedQty    Int      @default(0)
  plannedValue  Decimal  @db.Decimal(12, 2) @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, periodStart])
  @@index([periodStart])
  @@map("sales_plans")
}

// Bank reconciliation (CF19 Recon1888 / All Bank).
model BankReconciliation {
  id            String   @id @default(cuid())
  title         String
  asOf          DateTime @default(now())
  bookBalance   Decimal  @db.Decimal(14, 2)         // system ledger balance
  bankBalance   Decimal  @db.Decimal(14, 2)         // bank statement balance
  difference    Decimal  @db.Decimal(14, 2) @default(0)
  notes         String?
  status        String   @default("PENDING")        // PENDING | RECONCILED
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

    @@map("bank_reconciliations")
}

// ─── Cash Flow Module ──────────────────────────────────────────────────────────────────────────────────────────────────────

model BankAccount {
  id              String           @id @default(cuid())
  accountName     String
  accountNumber   String           @unique
  bankName        String
  accountType     BankAccountType  @default(SAVINGS)
  currency        String           @default("ETB")
  openingBalance  Decimal          @default(0) @db.Decimal(14, 2)
  currentBalance  Decimal          @default(0) @db.Decimal(14, 2)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])

  cashInflows     CashInflow[]
  cashOutflows    CashOutflow[]
  transfersFrom   BankTransfer[]   @relation("fromAccount")
  transfersTo     BankTransfer[]   @relation("toAccount")
  reconciliations BankReconciliation[]

  @@map("bank_accounts")
}

enum BankAccountType {
  SAVINGS
  CURRENT
  MOBILE_MONEY
  PETTY_CASH
}

model CashInflow {
  id            String           @id @default(cuid())
  amount        Decimal          @db.Decimal(12, 2)
  category      CashFlowCategory @default(SALES)
  reference     String?
  description   String?
  receivedAt    DateTime         @default(now())
  bankAccountId String
  bankAccount   BankAccount      @relation(fields: [bankAccountId], references: [id])
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])

  @@index([bankAccountId])
  @@index([receivedAt])
  @@map("cash_inflows")
}

model CashOutflow {
  id            String           @id @default(cuid())
  amount        Decimal          @db.Decimal(12, 2)
  category      CashFlowCategory
  reference     String?
  description   String?
  paidAt        DateTime         @default(now())
  bankAccountId String
  bankAccount   BankAccount      @relation(fields: [bankAccountId], references: [id])
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])

  @@index([bankAccountId])
  @@index([paidAt])
  @@map("cash_outflows")
}

model BankTransfer {
  id            String   @id @default(cuid())
  amount        Decimal  @db.Decimal(12, 2)
  description   String?
  reference     String?
  transferredAt DateTime @default(now())

  fromAccountId String
  fromAccount   BankAccount @relation("fromAccount", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     BankAccount @relation("toAccount", fields: [toAccountId], references: [id])
  createdById   String
  createdBy     User     @relation("transferCreatedBy", fields: [createdById], references: [id])

  @@map("bank_transfers")
}

model Budget {
  id            String        @id @default(cuid())
  category      CashFlowCategory
  periodLabel   String
  periodStart   DateTime
  periodEnd     DateTime
  plannedAmount Decimal       @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([category, periodStart])
  @@map("budgets")
}

model Loan {
  id            String        @id @default(cuid())
  lender        String
  principal     Decimal       @db.Decimal(14, 2)
  interestRate  Decimal       @db.Decimal(5, 2)
  startDate     DateTime
  endDate       DateTime?
  status        LoanStatus    @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String
  createdBy     User           @relation(fields: [createdById], references: [id])

  repayments    LoanRepayment[]

  @@map("loans")
}

model LoanRepayment {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12, 2)
  principal  Decimal  @db.Decimal(12, 2)
  interest   Decimal  @db.Decimal(12, 2)
  paidAt     DateTime @default(now())
  reference  String?
  notes      String?

  loanId     String
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdById String
  createdBy  User     @relation(fields: [createdById], references: [id])

  @@map("loan_repayments")
}

model Investment {
  id            String           @id @default(cuid())
  name          String
  type          InvestmentType
  amount        Decimal          @db.Decimal(14, 2)
  expectedReturn Decimal         @db.Decimal(12, 2)
  startDate     DateTime
  maturityDate  DateTime?
  status        InvestmentStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])

  @@map("investments")
}

// ─── Credit Management Module ────────────────────────────────────────────────

model CreditProfile {
  id                String         @id @default(cuid())
  customerId        String         @unique
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creditLimit       Decimal        @db.Decimal(12, 2)
  availableCredit   Decimal        @db.Decimal(12, 2)
  utilizedCredit    Decimal        @default(0) @db.Decimal(12, 2)
  creditScore       Int?
  riskLevel         CreditRisk     @default(LOW)
  paymentTerms      Int            @default(30)
  isActive          Boolean        @default(true)
  isBlocked         Boolean        @default(false)
  blockReason       String?
  approvedBy        String?
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  applications      CreditApplication[]
  transactions      CreditTransaction[]
  approvedByUser    User?          @relation("creditApprover", fields: [approvedBy], references: [id])

  @@index([customerId])
  @@index([riskLevel])
  @@map("credit_profiles")
}

model CreditApplication {
  id                String            @id @default(cuid())
  applicationNo     String            @unique
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id])
  requestedLimit    Decimal           @db.Decimal(12, 2)
  requestedTerms    Int
  purpose           String?
  status            CreditAppStatus   @default(PENDING)
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  profileId         String?
  profile           CreditProfile?    @relation(fields: [profileId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("credit_applications")
}

model CreditTransaction {
  id          String           @id @default(cuid())
  type        CreditTxnType
  amount      Decimal?          @db.Decimal(12, 2)
  oldValue    String?
  newValue    String?
  reason      String?
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  profileId   String
  profile     CreditProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([profileId])
  @@index([createdAt])
  @@map("credit_transactions")
}

model CreditAging {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bucket0to30   Decimal  @default(0) @db.Decimal(12, 2)
  bucket31to60  Decimal  @default(0) @db.Decimal(12, 2)
  bucket61to90  Decimal  @default(0) @db.Decimal(12, 2)
  bucket90plus  Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  asOf          DateTime @default(now())

  @@unique([customerId, asOf])
  @@index([asOf])
  @@map("credit_aging")
}

model CollectionCase {
  id            String           @id @default(cuid())
  caseNo        String           @unique
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  arStatementId String?
  arStatement   ARStatement?     @relation(fields: [arStatementId], references: [id])
  amount        Decimal          @db.Decimal(12, 2)
  assignedTo    String?
  assignedToUser User?          @relation(fields: [assignedTo], references: [id])
  priority      CollectionPriority @default(MEDIUM)
  status        CollectionStatus   @default(OPEN)
  dueDate       DateTime?
  resolvedAt    DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@map("collection_cases")
}

model OverdueNotification {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  arStatementId String?
  arStatement   ARStatement? @relation(fields: [arStatementId], references: [id])
  daysOutstanding Int
  amount        Decimal  @db.Decimal(12, 2)
  notifiedAt    DateTime @default(now())
  channel       String   @default("SYSTEM")
  notes         String?

  @@index([customerId])
  @@index([notifiedAt])
  @@map("overdue_notifications")
}

