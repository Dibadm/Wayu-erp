# ─────────────────────────────────────────────────────────────────────────────
# WAYU Pharmaceutical Inventory — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/wayu_inventory?schema=public"

# NextAuth.js — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this"
NEXTAUTH_URL="http://localhost:3000"

# ── AI Provider ───────────────────────────────────────────────────────────────
# Select which AI provider to use. Default: gemini (most cost-effective)
# Options: gemini | claude | openai
AI_PROVIDER=gemini

# Google Gemini (DEFAULT — free tier available)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Anthropic Claude (set AI_PROVIDER=claude to use)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI (set AI_PROVIDER=openai to use)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# ── Backup settings ───────────────────────────────────────────────────────────
BACKUP_DIR="/var/backups/wayu"

# Optional S3 upload
S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"

# Cron secret — generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"

# ── Public env vars ───────────────────────────────────────────────────────────
NEXT_PUBLIC_S3_BUCKET=""
